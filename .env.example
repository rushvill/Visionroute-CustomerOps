# VisionRoute Customer Ops — local/dev placeholders only.
# Copy to repo root `.env` and fill real values. Never commit `.env`.

APP_ENV=development
RUST_LOG=customer_ops_api=debug,tower_http=info,sqlx=warn

# API
API_HOST=0.0.0.0
API_PORT=8080
DATABASE_URL=postgres://customerops:customerops@127.0.0.1:5432/customerops

# Frontend (browser + BFF) — must match the URL you open in the browser
PUBLIC_API_BASE_URL=http://127.0.0.1:8080
BACKEND_API_BASE_URL=http://127.0.0.1:8080
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Auth secrets — generate before production:
#   openssl rand -base64 32
SESSION_SECRET=dev-only-change-me-before-production-use-32b
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECS=900

# Production only (first boot when users table is empty). Remove after login.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_EMAIL=ops@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=VisionRoute Admin
